{
  "name": "popop-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "펑펑 아레나 - 링크로 모여서 하는 3D 폭탄 아레나 멀티게임",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test shared/*.test.ts server/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
